# ============================================================
# 云印宝 Python / PyInstaller 通用 .gitignore
# ============================================================

# --- 构建产物 ---
build/
build_*/
dist/
dist_*/
release/
*.egg-info

# --- 运行时数据（用户私有） ---
data/
logs/
uploads/
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.so

# --- 备份文件 ---
*.bak
*.bak2
*.old
*~

# --- IDE / 编辑器 ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Windows 临时文件 ---
*.tmp
*.temp
*.lnk
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- 项目自带脚本产生的中间文件 ---
# SumatraPDF.exe 由 NSIS 安装时单独下载/包含，不入 git（避免 16MB 二进制）
tools/SumatraPDF.exe
# NSIS 临时构建产物
云印宝安装程序.exe
yunyinbao_setup_tmp.exe

# --- 测试 / 调试 ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- 环境 ---
.env
.venv/
venv/
env/
.python-version